{
  "defaultMode": "plan",
  "model": "claude-opus-4-6",
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 9007199254740991,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"{{- if eq .chezmoi.os "windows" }},
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
{{- end }}
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "windows" }}
            "command": "powershell -NoProfile -Command \"$d=[Console]::In.ReadToEnd()|ConvertFrom-Json; $f=[string]$d.tool_input.file_path; if($f -match '\\.(md|txt)$' -and $f -notmatch '(README|CLAUDE|AGENTS|CONTRIBUTING|SKILL|MEMORY)\\.(md|txt)$' -and $f -notmatch '[/\\\\](skills|memory)[/\\\\]'){[Console]::Error.WriteLine('[Hook] BLOCKED: arbitrary documentation file: ' + $f + '. Use README.md, CLAUDE.md, AGENTS.md, or CONTRIBUTING.md instead.'); exit 2}\""
{{- else }}
            "command": "input=$(cat); file_path=$(printf '%s' \"$input\" | jq -r '.tool_input.file_path // \"\"'); case \"$file_path\" in *.md|*.txt) case \"$file_path\" in *README.md|*CLAUDE.md|*AGENTS.md|*CONTRIBUTING.md|*SKILL.md|*MEMORY.md|*/skills/*|*/memory/*) ;; *) echo \"[Hook] BLOCKED: arbitrary documentation file: $file_path. Use README.md, CLAUDE.md, AGENTS.md, or CONTRIBUTING.md instead.\" >&2; exit 2 ;; esac ;; esac"
{{- end }}
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "windows" }}
            "command": "powershell -NoProfile -Command \"$d=[Console]::In.ReadToEnd()|ConvertFrom-Json; $f=[string]$d.tool_input.file_path; if($f -match '\\.(ts|tsx|js|jsx)$' -and (Test-Path $f)){$m=Select-String -Path $f -Pattern 'console\\.log'; if($m){[Console]::Error.WriteLine('[Hook] WARNING: console.log found in ' + $f); $m | Select-Object -First 5 | ForEach-Object {[Console]::Error.WriteLine($_.Line)}; [Console]::Error.WriteLine('[Hook] Remove console.log before committing'); exit 2}}\""
{{- else }}
            "command": "input=$(cat); file_path=$(printf '%s' \"$input\" | jq -r '.tool_input.file_path // \"\"'); case \"$file_path\" in *.ts|*.tsx|*.js|*.jsx) if [ -f \"$file_path\" ] && grep -q 'console\\.log' \"$file_path\" 2>/dev/null; then { echo \"[Hook] WARNING: console.log found in $file_path:\"; grep -n 'console\\.log' \"$file_path\" | head -5; echo \"[Hook] Remove console.log before committing\"; } >&2; exit 2; fi ;; esac"
{{- end }}
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(git:*)",
      "Bash(tree:*)",
      "Bash(find:*)"
{{- if eq .chezmoi.os "windows" }},
      "Bash(pwsh:*)",
      "Bash(pwsh.exe:*)",
      "Bash(powershell:*)",
      "Bash(powershell.exe:*)"
{{- end }}
    ],
    "deny": [
{{- if eq .chezmoi.os "windows" }}
      "Bash(Stop-Computer*)",
      "Bash(Restart-Computer*)",
      "Bash(shutdown*)",
      "Bash(Format-Volume*)",
      "Bash(Clear-Disk*)",
      "Bash(diskpart*)",
      "Bash(bcdedit*)",
      "Bash(*powershell*Stop-Computer*)",
      "Bash(*powershell*Restart-Computer*)",
      "Bash(*powershell*shutdown*)",
      "Bash(*powershell*Format-Volume*)",
      "Bash(*powershell*Clear-Disk*)",
      "Bash(*powershell*diskpart*)",
      "Bash(*powershell*bcdedit*)",
      "Bash(*pwsh*Stop-Computer*)",
      "Bash(*pwsh*Restart-Computer*)",
      "Bash(*pwsh*shutdown*)",
      "Bash(*pwsh*Format-Volume*)",
      "Bash(*pwsh*Clear-Disk*)",
      "Bash(*pwsh*diskpart*)",
      "Bash(*pwsh*bcdedit*)"
{{- else }}
      "Bash(shutdown)",
      "Bash(reboot)",
      "Bash(halt)",
      "Bash(poweroff)",
      "Bash(mkfs)",
      "Bash(dd)",
      "Bash(fdisk)",
      "Bash(parted)",
      "Bash(sudo)",
      "Bash(doas)",
      "Bash(su)"
{{- end }}
    ],
    "ask": [
      "Bash(git push:*)",
{{- if eq .chezmoi.os "windows" }}
      "Bash(Remove-Item*)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(rmdir*)",
      "Bash(icacls*)",
      "Bash(Set-Acl*)",
      "Bash(Stop-Process*)",
      "Bash(taskkill*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
{{- else }}
      "Bash(rm)",
      "Bash(chmod)",
      "Bash(chown)",
      "Bash(kill)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
{{- end }}
    ]
  },
  "statusLine": {
    "type": "command",
{{- if eq .chezmoi.os "windows" }}
    "command": "{{ if .portable }}powershell{{ else }}pwsh{{ end }} -NoProfile -File \"{{ .chezmoi.homeDir | replace "\\" "\\\\" }}\\.claude\\statusline.ps1\""
{{- else }}
    "command": "bash ~/.claude/statusline.sh"
{{- end }}
  }
}
