#!/usr/bin/env python3
"""Push a 100% stacked column chart of memory composition to a TerminalWidget target.

A Muller-plot style view: how the App / Wired / Compressed / Cached / Free mix
shifts over time, each column normalised to full height.

Terminal Widget has no stacked chart format - grouped series render side by side -
so the chart is drawn with block glyphs. Two tricks make that legible:

  * Monospace cells abut exactly, so columns touch with no gaps between them.
  * Each cell carries TWO colours (ANSI foreground and background), and the lower
    block glyphs U+2581..U+2588 fill 1/8..8/8 of the cell. A band boundary can
    therefore land anywhere on an eighth, giving HEIGHT*8 levels rather than
    HEIGHT. At HEIGHT=8 that is 64 levels (1.6% of RAM) instead of 8 (12.5%),
    which is the difference between seeing the mix move and not.

Rendering to a PNG would be finer still, but the sandboxed CLI only reads images
from its own group container, and a launchd-spawned process cannot write there
without Full Disk Access. Text has no such restriction, so this runs on a timer
with no permission grant.
"""

from __future__ import annotations

import subprocess
import sys
from collections import Counter
from pathlib import Path

TARGET = "widget1"
COLUMNS = 20          # samples across; one per run
HEIGHT = 8            # character rows
SUB = 8               # sub-levels per row, from the eighth-block glyphs

HOME = Path.home()
WIDGET = HOME / ".local/bin/terminal-widget"
HISTORY = HOME / ".local/state/terminal-widget/memory-mix.csv"

# Stacked bottom to top. Distinct catppuccin hues - these are categories, not a
# scale, so they must not read as an ordered ramp.
BANDS = [
    ("app",        "A", (203, 166, 247)),   # mauve
    ("wired",      "W", (243, 139, 168)),   # rose
    ("compressed", "C", (250, 179, 135)),   # peach
    ("cached",     "H", (116, 199, 236)),   # sapphire
    ("free",       "F", (148, 226, 213)),   # teal
]


def memory_sample() -> dict[str, float]:
    """Memory split into the categories Activity Monitor reports, in GB.

    Cached (inactive) is reclaimable-but-occupied, so it stays its own band
    rather than being folded into either used or free. memory_pressure's "free
    percentage" measures pressure, not usage, and reads far too optimistic.
    """
    raw = subprocess.run(["vm_stat"], capture_output=True, text=True, check=True).stdout
    total = int(subprocess.run(["sysctl", "-n", "hw.memsize"],
                               capture_output=True, text=True, check=True).stdout)

    page = 4096
    counts: dict[str, int] = {}
    for line in raw.splitlines():
        if "page size of" in line:
            page = int(line.split("page size of")[1].split()[0])
            continue
        label, _, value = line.partition(":")
        digits = value.strip().rstrip(".")
        if digits.isdigit():
            counts[label.strip()] = int(digits)

    scale = page / 1073741824
    return {
        "app": counts.get("Pages active", 0) * scale,
        "wired": counts.get("Pages wired down", 0) * scale,
        "compressed": counts.get("Pages occupied by compressor", 0) * scale,
        "cached": counts.get("Pages inactive", 0) * scale,
        "free": counts.get("Pages free", 0) * scale,
        "total": total / 1073741824,
    }


def update_history(sample: dict[str, float]) -> list[list[float]]:
    HISTORY.parent.mkdir(parents=True, exist_ok=True)
    with HISTORY.open("a") as handle:
        handle.write(",".join(f"{sample[name]:.3f}" for name, _, _ in BANDS) + "\n")

    kept = HISTORY.read_text().splitlines()[-COLUMNS:]
    HISTORY.write_text("\n".join(kept) + "\n")

    columns = []
    for line in kept:
        try:
            values = [float(v) for v in line.split(",")]
        except ValueError:
            continue
        if len(values) == len(BANDS) and sum(values) > 0:
            columns.append(values)
    return columns


def sublevels(values: list[float]) -> list[int]:
    """Category index occupying each sub-level of a column, bottom to top."""
    total = sum(values)
    boundaries, running = [], 0.0
    for value in values:
        running += value / total
        boundaries.append(running)

    levels = []
    for step in range(HEIGHT * SUB):
        position = (step + 0.5) / (HEIGHT * SUB)
        band = len(values) - 1
        for index, edge in enumerate(boundaries):
            if position <= edge:
                band = index
                break
        levels.append(band)
    return levels


def cell(levels: list[int], row: int) -> str:
    """One character: the lower part is the foreground colour, the upper the background.

    A cell spanning three or more bands can only show two, so the lowest band
    keeps its exact boundary and the rest collapse to whichever dominates above
    it. With eight rows over five bands that is rare, and the error is under one
    eighth of a row.
    """
    slice_ = levels[row * SUB:(row + 1) * SUB]
    lower = slice_[0]
    filled = 0
    while filled < SUB and slice_[filled] == lower:
        filled += 1

    lower_rgb = BANDS[lower][2]
    if filled == SUB:
        return "\033[38;2;{};{};{}m█".format(*lower_rgb)

    upper = Counter(slice_[filled:]).most_common(1)[0][0]
    upper_rgb = BANDS[upper][2]
    glyph = chr(0x2580 + filled)          # U+2581..U+2587 = 1/8..7/8 from the bottom
    return "\033[48;2;{};{};{}m\033[38;2;{};{};{}m{}".format(*upper_rgb, *lower_rgb, glyph)


def chart(columns: list[list[float]]) -> list[str]:
    grid = [sublevels(values) for values in columns]
    # Newest at the right: while history fills, pad the left rather than
    # stretching a few samples across the full width, which would imply history
    # that was never measured.
    pad = COLUMNS - len(grid)
    lines = []
    for row in range(HEIGHT - 1, -1, -1):
        lines.append(" " * pad + "".join(cell(levels, row) for levels in grid) + "\033[0m")
    return lines


def legend() -> str:
    return " ".join(
        "\033[38;2;{};{};{}m█{}".format(*rgb, key) for _, key, rgb in BANDS
    ) + "\033[0m"


def main() -> None:
    sample = memory_sample()
    used = sample["app"] + sample["wired"] + sample["compressed"]
    percent = round(used / sample["total"] * 100)

    body = "\n".join(chart(update_history(sample)) + [legend()])

    subprocess.run([
        str(WIDGET),
        "--target", TARGET,
        "--background-mode",
        "--text", "-",
        "--ansi-mode", "on",
        "--no-wrap",
        "--font", "Menlo",
        "--font-size", "11",
        "--theme", "dark",
        "--bg", "1E1E2E",
        "--title", f"Memory  {percent}%",
        "--title-color", "CDD6F4",
    ], input=body, text=True, check=True)


if __name__ == "__main__":
    sys.exit(main())
