#!/usr/bin/env bash
# Push a 100% stacked column chart of memory composition to a TerminalWidget
# target - a Muller-plot style view of how the mix of App / Wired / Compressed /
# Cached / Free shifts over time, each column normalised to full height.
#
# Terminal Widget has no stacked chart format (grouped series render side by
# side), so the chart is drawn with block characters: monospace cells abut
# exactly, which is what removes the gaps between columns.
#
# House style of terminalwidget.app/recipes: one small script per widget,
# scheduled by a launchd user agent, content piped in.
#
# TARGET must match the "Target name" in the widget's Edit Widget panel.

set -euo pipefail

TARGET=widget1
WIDTH=20            # columns of history, one per run
HEIGHT=8            # character rows; each row is 1/HEIGHT of total RAM
WIDGET="$HOME/.local/bin/terminal-widget"
HISTORY="${XDG_STATE_HOME:-$HOME/.local/state}/terminal-widget/memory-mix.csv"

# Sampled once and reused for the title and the chart: two vm_stat calls could
# straddle an allocation and disagree with each other.
sample=$(vm_stat)
total_bytes=$(sysctl -n hw.memsize)

# app,wired,compressed,cached,free in GB. Cached (inactive) is
# reclaimable-but-occupied, so it is its own band rather than folded into
# either used or free.
read -r app wired compressed cached free percent <<EOF
$(printf '%s\n' "$sample" | awk -v total="$total_bytes" '
    /page size of/                  { page = $8 }
    /Pages active/                  { active = $3 }
    /Pages inactive/                { inactive = $3 }
    /Pages wired down/              { wired = $4 }
    /Pages occupied by compressor/  { compressed = $5 }
    /Pages free/                    { free = $3 }
    END {
        gsub(/\./, "", active); gsub(/\./, "", inactive); gsub(/\./, "", wired)
        gsub(/\./, "", compressed); gsub(/\./, "", free)
        gb = 1073741824
        printf "%.2f %.2f %.2f %.2f %.2f %d",
            active * page / gb, wired * page / gb, compressed * page / gb,
            inactive * page / gb, free * page / gb,
            ((active + wired + compressed) * page / total) * 100
    }')
EOF

mkdir -p "$(dirname "$HISTORY")"
printf '%s,%s,%s,%s,%s\n' "$app" "$wired" "$compressed" "$cached" "$free" >> "$HISTORY"
scratch=$(mktemp)
tail -n "$WIDTH" "$HISTORY" > "$scratch"
mv "$scratch" "$HISTORY"

{
    awk -F, -v H="$HEIGHT" '
        # Rows per band are allocated by the largest-remainder method. Plain
        # rounding would let a column total H-1 or H+1 rows, so columns would
        # come out ragged instead of all reaching full height.
        {
            col++
            total = 0
            for (i = 1; i <= 5; i++) { value[i] = $i + 0; total += value[i] }
            if (total <= 0) total = 1

            used = 0
            for (i = 1; i <= 5; i++) {
                exact = value[i] / total * H
                whole = int(exact)
                rows[col, i] = whole
                remainder[i] = exact - whole
                used += whole
            }
            for (leftover = H - used; leftover > 0; leftover--) {
                best = -1; pick = 0
                for (i = 1; i <= 5; i++) if (remainder[i] > best) { best = remainder[i]; pick = i }
                if (pick == 0) break
                rows[col, pick]++
                remainder[pick] = -1
            }
        }
        END {
            # Catppuccin, stacked bottom to top: App, Wired, Compressed,
            # Cached, Free. Distinct hues - these are categories, not a scale.
            red[1] = 203; grn[1] = 166; blu[1] = 247   # mauve
            red[2] = 243; grn[2] = 139; blu[2] = 168   # rose
            red[3] = 250; grn[3] = 179; blu[3] = 135   # peach
            red[4] = 116; grn[4] = 199; blu[4] = 236   # sapphire
            red[5] = 148; grn[5] = 226; blu[5] = 213   # teal

            # band H is the top of the column, band 1 the bottom.
            for (band = H; band >= 1; band--) {
                line = ""
                for (c = 1; c <= col; c++) {
                    stack = 0
                    category = 5
                    for (i = 1; i <= 5; i++) {
                        stack += rows[c, i]
                        if (band <= stack) { category = i; break }
                    }
                    line = line sprintf("\033[38;2;%d;%d;%dm\xe2\x96\x88",
                                        red[category], grn[category], blu[category])
                }
                print line "\033[0m"
            }
        }
    ' "$HISTORY"

    # Legend. Single letters keep it inside the small widget's ~23 characters:
    # App, Wired, Compressed, cacHed, Free.
    printf '\033[38;2;203;166;247m\xe2\x96\x88A\033[0m'
    printf '\033[38;2;243;139;168m \xe2\x96\x88W\033[0m'
    printf '\033[38;2;250;179;135m \xe2\x96\x88C\033[0m'
    printf '\033[38;2;116;199;236m \xe2\x96\x88H\033[0m'
    printf '\033[38;2;148;226;213m \xe2\x96\x88F\033[0m\n'
} | "$WIDGET" \
    --target "$TARGET" \
    --background-mode \
    --text - \
    --ansi-mode on \
    --no-wrap \
    --font Menlo \
    --font-size 11 \
    --theme dark \
    --bg-gradient-from 1E1E2E \
    --bg-gradient-to 11111B \
    --bg-gradient-start NW \
    --title "Memory  ${percent}%" \
    --title-color CDD6F4 \
    --timestamp \
    --caption-color 9399B2
