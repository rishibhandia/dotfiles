#!/usr/bin/env bash
# Push the top energy consumers to a TerminalWidget target.
#
# Same house style as tw-memory: one small script per widget, scheduled by a
# launchd user agent, content piped in.
#
# TARGET must match the "Target name" in the widget's Edit Widget panel, and
# must differ from the memory widget's - two scripts writing one target just
# overwrite each other every interval.

set -euo pipefail

TARGET=energy
ROWS=4
BAR_WIDTH=6
WIDGET="$HOME/.local/bin/terminal-widget"

# top's POWER column is macOS's relative energy-impact score - the same figure
# Activity Monitor's "Energy" tab shows. It is a unitless weighting of CPU,
# GPU, wakeups and I/O, not watts, so treat it as a ranking rather than a
# measurement.
#
# Two samples are required: the first has no interval to compute a delta over.
# PIDs are joined against full command paths so a browser's content processes
# roll up under the browser instead of filling the table with helper rows.
energy_by_app() {
    awk '
        NR == FNR { pid = $1; $1 = ""; sub(/^ /, ""); path[pid] = $0; next }
        {
            p = path[$1]
            if (p == "") next
            if (match(p, /\.app\//)) {
                head = substr(p, 1, RSTART - 1)
                n = split(head, parts, "/")
                name = parts[n]
            } else {
                n = split(p, parts, "/")
                name = parts[n]
            }
            # Drop top itself; it always ranks high in its own measurement.
            if (name != "" && name != "top") total[name] += $2
        }
        END { for (k in total) printf "%.1f\t%s\n", total[k], k }
    ' <(ps -Ao pid=,comm=) \
      <(top -l 2 -o power -n 40 -stats pid,power 2>/dev/null \
          | awk '/^PID/ { sample++ } sample == 2 && !/^PID/ && NF >= 2 { print $1, $2 }') \
    | sort -rn
}

# Rendered as ANSI-coloured text rather than --table: tables take their colour
# from widget-level flags only, with no per-row control, so a table cannot show
# severity. Truecolor escapes survive into the payload and --ansi-mode on makes
# the widget render them.
#
# Bars are scaled to the top consumer so the ranking reads at a glance without
# parsing the numbers.
energy_by_app | head -"$ROWS" | awk -F'\t' -v width="$BAR_WIDTH" '
    NR == 1 { peak = $1 + 0 }
    {
        impact = $1 + 0
        # Plain truncation, no ellipsis: awk pads %-9s by bytes, and a
        # multi-byte character silently overruns the field and breaks alignment.
        name = substr($2, 1, 9)

        share = (peak > 0) ? impact / peak : 0
        filled = int(share * width + 0.5)

        # Catppuccin rose / peach / yellow / teal, keyed to share of the top
        # consumer rather than an absolute scale, which would read uniformly
        # cool on an idle machine and tell you nothing.
        if      (share >= 0.75) { r = 243; g = 139; b = 168 }
        else if (share >= 0.45) { r = 250; g = 179; b = 135 }
        else if (share >= 0.20) { r = 249; g = 226; b = 175 }
        else                    { r = 148; g = 226; b = 213 }

        bar = ""
        for (i = 0; i < filled; i++)      bar = bar "\xe2\x96\x88"  # full block
        for (i = filled; i < width; i++)  bar = bar "\xe2\x96\x91"  # light shade

        printf "\033[38;2;%d;%d;%dm%-9s %s %4.1f\033[0m\n", r, g, b, name, bar, impact
    }
' | "$WIDGET" \
    --target "$TARGET" \
    --background-mode \
    --text - \
    --ansi-mode on \
    --no-wrap \
    --font Menlo \
    --font-size 11 \
    --theme dark \
    --bg-gradient-from 1E1E2E \
    --bg-gradient-to 11111B \
    --bg-gradient-start NW \
    --title "Energy" \
    --title-color CDD6F4 \
    --timestamp \
    --caption-color 9399B2
