{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ai-parity:journal:2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "transaction_id", "generation_id", "status"],
  "properties": {
    "schema_version": {"const": 2}, "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"const": "prepared"},
    "operation": {"enum": ["sync", "reconcile-after-merge"]},
    "transaction_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
