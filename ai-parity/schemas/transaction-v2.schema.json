{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ai-parity:transaction:2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "transaction_id", "status", "generation_id", "entries"],
  "properties": {
    "schema_version": {"const": 2}, "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "status": {"enum": ["prepared", "rendered", "rolled_back"]},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {"enum": ["sync", "reconcile-after-merge"]},
    "transaction_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["exists", "sha256", "mode", "data"], "properties": {"exists": {"type": "boolean"}, "sha256": {"type": ["string", "null"]}, "mode": {"type": ["integer", "null"]}, "data": {"type": ["string", "null"]}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["path", "old", "new"], "properties": {"path": {"type": "string"}, "old": {"$ref": "#/$defs/snapshot"}, "new": {"$ref": "#/$defs/snapshot"}}}
  }
}
