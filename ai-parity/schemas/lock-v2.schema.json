{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ai-parity:lock:2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "pid", "host", "token", "transaction_id", "operation"],
  "properties": {
    "schema_version": {"const": 2}, "pid": {"type": "integer", "minimum": 1}, "host": {"type": "string"},
    "token": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "transaction_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "operation": {"enum": ["sync", "reconcile-after-merge"]},
    "generation_id": {"type": ["string", "null"]}, "transaction_digest": {"type": ["string", "null"]}
  }
}
