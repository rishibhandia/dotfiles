# =============================================================================
# OS-specific scripts - ignore on other platforms
# Note: .chezmoiignore uses TARGET paths, so remove run_once_/run_onchange_ prefixes
# =============================================================================

# macOS-only scripts (darwin directory)
{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin/configure-macos.sh
.chezmoiscripts/darwin/set-default-terminal.sh
{{ end }}

# Windows-only scripts
{{ if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/install-scoop.ps1
.chezmoiscripts/windows/00-install-packages.ps1
.chezmoiscripts/windows/01-install-cli-tools.ps1
.chezmoiscripts/windows/configure-windows-terminal.ps1
.chezmoiscripts/windows/install-fonts.ps1
{{ end }}

# WSL-only scripts
{{ if not (and (eq .chezmoi.os "linux") (lookPath "wslpath")) }}
.chezmoiscripts/wsl/install-wsl-packages.sh
{{ end }}

# =============================================================================
# Unix-only configs — skip on Windows
# =============================================================================
{{ if eq .chezmoi.os "windows" }}
.config/zsh
.config/ghostty
.config/tmux
.config/nvim
.zshenv
.Brewfile
# uv/uvx binaries get locked on Windows; install via uv's own installer instead
.local/bin/uv.exe
.local/bin/uvx.exe
{{ end }}

# =============================================================================
# macOS-only skills (require macOS apps)
# =============================================================================
{{ if ne .chezmoi.os "darwin" }}
.claude/skills/things
.claude/skills/fantastical
.claude/skills/keynote
{{ end }}

# =============================================================================
# Personal-machine-only skills (local Zotero library, Keynote decks)
# =============================================================================
{{ if not .personal }}
.claude/skills/keynote
.claude/skills/zotero
{{ end }}

# =============================================================================
# Windows-only shell configs — skip on macOS/Linux to avoid clobbering
# existing .bashrc/.bash_profile on those platforms. AppData holds Windows
# targets (nvim's $LOCALAPPDATA config).
# =============================================================================
{{ if ne .chezmoi.os "windows" }}
.bashrc
.bash_profile
AppData
{{ end }}

# =============================================================================
# Mac-mini-only files — skip everywhere else
# =============================================================================
{{ if ne .hostname "rishi-macmini-2020" }}
.local/share/adguardhome-seed
Library/LaunchAgents/com.rishi.colima.plist
Library/LaunchAgents/com.rishi.jellyfin.plist
{{ end }}

# =============================================================================
# Age encryption key — pulled from 1Password, only useful on personal
# machines that also have `op` CLI. Skip on non-personal machines (work,
# ephemeral) and portable installs (no 1Password) so apply never invokes op.
# =============================================================================
{{ if or .portable (not .personal) }}
.config/age/key.txt
{{ end }}

# =============================================================================
# Repo-only files — never applied to ~/ (chezmoi treats any non-dot source
# file as a target). CLAUDE.md global rules live in dot_claude/CLAUDE.md.
# =============================================================================
CLAUDE.md
LICENSE
README.md
install.sh
install.ps1
scripts
