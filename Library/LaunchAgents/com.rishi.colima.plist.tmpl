<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Auto-start Colima at login on the Mac mini (always-on LAN/Docker host).
  Replaces `brew services start colima` so COLIMA_HOME can be pinned to the
  XDG location (~/.config/colima); Colima 0.10.x has flaky XDG auto-detection.
  Managed by chezmoi; gated to the mini via .chezmoiignore.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rishi.colima</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/colima</string>
        <string>start</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>COLIMA_HOME</key>
        <string>{{ .chezmoi.homeDir }}/.config/colima</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/colima/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/colima/launchd.err.log</string>
</dict>
</plist>
