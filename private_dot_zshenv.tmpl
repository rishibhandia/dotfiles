# -*-mode:bash-*- vim:ft=bash
#
# ~/.zshenv
#
{{- /* Template for .zshenv */ -}}

#If debug flag enabled (ZSH_DEBUG = 1), will print file path and name when sourced
[ ! -z "$ZSH_DEBUG" ] && printf "Sourcing file %s (path: %s)\n" "${(%):-%N}" "${(%):-%x}"

###############################
# EXPORT ENVIRONMENT VARIABLE #
###############################
# Don't force TERM here: terminals (Ghostty: xterm-ghostty) and tmux
# (tmux-256color) set it correctly themselves; .zshenv runs for every zsh
# and would clobber it.
export COLORTERM='truecolor'

# XDG
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
{{- if eq .hostname "rishi-macmini-2020" }}

# Colima: pin config to the XDG location instead of legacy ~/.colima
# (Colima 0.10.x has flaky XDG auto-detection; set it explicitly).
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"
{{- end }}

# editor — CotEditor when available (macOS GUI), nvim otherwise.
# `cot -w` waits for the document to close so git/crontab/chezmoi edit work.
if command -v cot >/dev/null 2>&1; then
    export EDITOR="cot -w"
    export VISUAL="cot -w"
else
    export EDITOR="nvim"
    export VISUAL="nvim"
fi

# zsh
# Setting ZDOTDIR so zsh doesn't make stuff in HOME dir
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export HISTFILE="$ZDOTDIR/.zhistory"    # History filepath
export HISTSIZE=10000                   # Maximum events for internal history
export SAVEHIST=10000                   # Maximum events in history file
setopt HIST_IGNORE_DUPS
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY

# Various Applications
export SCREENSHOT="$HOME/Pictures/screenshots"
export VIMCONFIG="$XDG_CONFIG_HOME/nvim"
# Pin navi to the chezmoi-managed cheats dir (its built-in default varies by
# platform/version: XDG on Linux, Application Support on some macOS builds)
export NAVI_PATH="$XDG_DATA_HOME/navi/cheats"

# Homebrew
{{- if eq .chezmoi.os "darwin" }}
{{-   if eq .chezmoi.arch "arm64" }}
# Apple Silicon Mac (guarded: don't error before Homebrew is bootstrapped)
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{-   else }}
# Intel Mac (guarded: don't error before Homebrew is bootstrapped)
[ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"
{{-   end }}
{{- else if eq .chezmoi.os "linux" }}
# Linux (guarded: don't error before Linuxbrew is bootstrapped)
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

# Local bin
export PATH="$HOME/.local/bin:$PATH"

{{- if .personal }}
# API Keys from 1Password (personal machines only)
{{- with (onepassword "OpenAI API Key").fields -}}
{{- range . -}}
{{- if eq .id "credential" }}
export OPENAI_API_KEY="{{ .value }}"
{{- end -}}
{{- end -}}
{{- end }}

{{- with (onepassword "OpenRouter API Key").fields -}}
{{- range . -}}
{{- if eq .id "credential" }}
export OPENROUTER_API_KEY="{{ .value }}"
{{- end -}}
{{- end -}}
{{- end }}

export OPENROUTER_KEY="$OPENROUTER_API_KEY"
export LLM_OPENROUTER_KEY="$OPENROUTER_KEY"

{{- with (onepassword "Anthropic API Key").fields -}}
{{- range . -}}
{{- if eq .id "credential" }}
export ANTHROPIC_API_KEY="{{ .value }}"
{{- end -}}
{{- end -}}
{{- end }}

{{- with (onepassword "Google Gemini API Key").fields -}}
{{- range . -}}
{{- if eq .id "credential" }}
export LLM_GEMINI_KEY="{{ .value }}"
{{- end -}}
{{- end -}}
{{- end }}

# SSH agent for 1Password
{{- if eq .chezmoi.os "darwin" }}
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
{{- end }}
{{- end }}

# Cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"



