# -*-mode:conf-toml-*- vim:ft=toml
# ~/.local/share/chezmoi/.chezmoi.toml.tmpl
# =============================================================================
# Used to customize configuration when doing a `chezmoi init`.
#
# This template file will trigger prompts to fill-in machine-specific
# templateable values. The resulting file is then created at
# `~/.config/chezmoi/chezmoi.toml`
# See https://www.chezmoi.io/docs/how-to/
#
{{/* boolean feature tags */}}
{{- $ephemeral := false -}}{{/* true if this machine is ephemeral, e.g. a cloud or VM instance */}}
{{- $work := false -}}{{/* true if this machine is a work machine */}}
{{- $headless := false -}}{{/* true if this machine does not have a screen and keyboard */}}
{{- $personal := false -}}{{/* true if this machine should have personal secrets */}}
{{- $portable := false -}}{{/* true if no package manager available (use portable binaries) */}}
{{- "" -}}
{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}
{{/* detect GitHub codespaces, VSCode remote containers, Docker containers, Multipass VMs, and Vagrant boxes */}}
{{- if or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") (eq .chezmoi.username "root" "ubuntu" "vagrant" "vscode") -}}
{{-   $ephemeral = true -}}
{{-   $headless = true -}}
{{- end -}}
{{/* work around unreliable hostname on darwin: prefer the stable hardware
     model (immune to DHCP hostname noise and ComputerName edits), then fall
     back to ComputerName for machines named before this approach */}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $computerName := output "scutil" "--get" "ComputerName" | trim -}}
{{-   $model := output "sysctl" "-n" "hw.model" | trim -}}
{{-   if eq $model "Mac17,7" -}}
{{-     $hostname = "rishi-mbp-2025" -}}{{/* MacBook Pro 14" M5 Max */}}
{{-   else if contains "MacBook Pro 2019" $computerName -}}
{{-     $hostname = "rishi-mbp-2019" -}}
{{-   else if or (eq $model "Macmini9,1") (contains "Mac Mini 2020" $computerName) -}}
{{-     $hostname = "rishi-macmini-2020" -}}{{/* M1 Mac mini 2020; hw.model verified on the machine 2026-08-28. ComputerName kept as fallback — this host gates the whole server stack */}}
{{-   else -}}
{{-     $hostname = $computerName -}}
{{-   end -}}
{{- end -}}
{{/* Detect portable mode on Windows (no Scoop available) */}}
{{- if eq .chezmoi.os "windows" -}}
{{-   if not (lookPath "scoop") -}}
{{-     $portable = true -}}
{{-   end -}}
{{- end -}}

{{/* Determine machine type */}}
{{- if not $ephemeral -}}
{{-   if eq $hostname "rishi-macmini-2020" -}}
{{-     $personal = true -}}
{{-   else if eq $hostname "rishi-mbp-2019" -}}
{{-     $personal = true -}}
{{-   else if eq $hostname "rishi-mbp-2025" -}}
{{-     $personal = true -}}
{{-   else if eq $hostname "ubuntu" -}}
{{-     $headless = true -}}
{{-     $personal = true -}}
{{-   else if stdinIsATTY -}}
{{/* Unknown machine - prompt for configuration */}}
{{-     $personal = promptBoolOnce . "personal" "Is this a personal machine (has 1Password, personal secrets)" -}}
{{-     if not $personal -}}
{{-       $work = true -}}
{{-     end -}}
{{-     $headless = promptBoolOnce . "headless" "Is this a headless machine (no display)" -}}
{{-     $ephemeral = promptBoolOnce . "ephemeral" "Is this an ephemeral machine (temporary, cloud VM)" -}}
{{-   else -}}
{{/* Non-interactive, unknown machine - assume ephemeral work machine */}}
{{-     $ephemeral = true -}}
{{-     $headless = true -}}
{{-     $work = true -}}
{{-   end -}}
{{- end -}}
{{- $email := "rishi@bhandia.com" -}}
{{- if $work -}}
{{-   $email = "rb3926@nyu.edu" -}}
{{- end -}}
{{- $name := "Rishi Bhandia" -}}
{{- $age_recipient := "" -}}
{{- if $personal -}}
{{-   $age_recipient = promptStringOnce . "age_recipient" "Your age public key (run on the source machine: grep '^# public key:' ~/.config/age/key.txt)" -}}
{{- end -}}

{{ if $personal -}}
encryption = "age"
{{ end -}}
[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    ephemeral = {{ $ephemeral }}
    work = {{ $work }}
    headless = {{ $headless }}
    hostname = {{ $hostname | quote }}
    personal = {{ $personal }}
    portable = {{ $portable }}
    osid = {{ $osID | quote }}
{{- if $personal }}
    age_recipient = {{ $age_recipient | quote }}
{{- end }}

{{ if eq .chezmoi.os "windows" }}
[cd]
    command = "pwsh"
{{ end }}
[interpreters.py]
    command = "uvx"
    args = ["python"]
[github]
    refreshPeriod = "12h"
    
[git]
    autoAdd = true
    autoCommit = false
    
[onepassword]
    command = "op"
    prompt = false  # Won't prompt for authentication if already signed in

[onepassword.template]
    # This will allow chezmoi to automatically sign in to 1password
    # Optional: specify account and vault if you have multiple
    # account = "my-account"
    # vault = "my-vault"

{{ if $personal -}}
[age]
    identity = "~/.config/age/key.txt"
    recipient = {{ $age_recipient | quote }}
{{- end }}
