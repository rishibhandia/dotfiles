{{ if and (eq .chezmoi.os "darwin") (eq .hostname "rishi-macmini-2020") -}}
#!/bin/bash
# Run Colima from its XDG location (~/.config/colima) with the resources and
# drive mount needed to host Shoko Server (Docker) for the Jellyfin anime
# library. Replaces the old `brew services start colima` approach so we can:
#   - pin COLIMA_HOME (Colima 0.10.x has flaky XDG auto-detection), and
#   - mount the external media drive (/Volumes/Easystore) into the VM.
# Auto-start at login is handled by the chezmoi-managed LaunchAgent
# ~/Library/LaunchAgents/com.rishi.colima.plist.
#
# Idempotent: creates the VM only if it doesn't already exist, and NEVER
# deletes an existing VM (that would wipe Docker named volumes such as
# Shoko's database). Recreating the VM is a deliberate manual step.
# No-op on every other machine.

set -e

eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"

PLIST="$HOME/Library/LaunchAgents/com.rishi.colima.plist"
MEDIA_MOUNT="/Volumes/Easystore"

if ! command -v colima >/dev/null 2>&1; then
    echo "colima not installed yet; brew bundle should install it before this runs" >&2
    exit 0
fi

# Retire the old brew-services registration if present (harmless otherwise).
brew services stop colima >/dev/null 2>&1 || true

# Create the VM at the XDG location if it doesn't exist yet. Do NOT delete an
# existing VM here -- that would destroy container volumes (e.g. Shoko's DB).
if ! colima status >/dev/null 2>&1; then
    echo "Creating Colima VM at $COLIMA_HOME (4 CPU / 6 GiB; $MEDIA_MOUNT mounted read-only)..."
    colima start \
        --cpu 4 --memory 6 --disk 100 \
        --vm-type vz --mount-type virtiofs \
        --mount "$MEDIA_MOUNT"
else
    colima start >/dev/null 2>&1 || true   # ensure it's running
fi

# Install / refresh the auto-start LaunchAgent (chezmoi has written the plist).
mkdir -p "$XDG_STATE_HOME/colima"
if [ -f "$PLIST" ]; then
    launchctl unload "$PLIST" >/dev/null 2>&1 || true
    launchctl load "$PLIST" >/dev/null 2>&1 || true
fi
{{ end -}}
