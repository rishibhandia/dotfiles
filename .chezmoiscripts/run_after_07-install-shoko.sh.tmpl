{{ if and (eq .chezmoi.os "darwin") (eq .hostname "rishi-macmini-2020") -}}
#!/bin/bash
# Install/refresh Shoko Server as a Docker container on the Mac mini. Shoko is
# the anime metadata + organization backend that Jellyfin's Shokofin plugin
# talks to. Apple Silicon native Shoko is unsupported upstream, so we run the
# official image on Colima (the VM is created by run_once_after_05).
#
# The anime drive is bind-mounted at the SAME path it has on the host
# (/Volumes/Easystore/Movies & Shows) so the symlinks Shokofin builds on the
# host resolve with no path remapping. Shoko's own data lives in a Docker named
# volume so it survives container recreation (mounting the config dir wrong is a
# known data-loss footgun).
#
# Runs on EVERY apply (run_, not run_once) so a skipped precondition (docker
# missing, Colima down) retries next apply instead of being recorded done
# forever. When Shoko is already up and the compose file is unchanged it
# fast-path exits. No-op on every other machine.

set -e

eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true

: "${XDG_CONFIG_HOME:=$HOME/.config}"
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"

COMPOSE_DIR="$XDG_CONFIG_HOME/shoko"
COMPOSE_FILE="$COMPOSE_DIR/docker-compose.yml"
MEDIA="/Volumes/Easystore/Movies & Shows"

if ! command -v docker >/dev/null 2>&1; then
    echo "docker not installed yet; retrying on the next chezmoi apply" >&2
    exit 0
fi

# Colima (the Docker daemon) must be up; run_after_05 handles this.
if ! colima status >/dev/null 2>&1; then
    echo "Colima is not running (run_after_05 starts it); retrying Shoko next apply" >&2
    exit 0
fi

# Homebrew's docker formula is the bare CLI; the Compose v2 plugin comes from
# the docker-compose formula and the CLI only finds it when
# ~/.docker/config.json lists the plugin dir (brew caveat). Wire it up once.
if ! docker compose version >/dev/null 2>&1; then
    BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
    PLUGINS_DIR="$BREW_PREFIX/lib/docker/cli-plugins"
    [ -d "$PLUGINS_DIR" ] || PLUGINS_DIR="$BREW_PREFIX/opt/docker-compose/bin"
    DOCKER_CFG="$HOME/.docker/config.json"
    mkdir -p "$HOME/.docker"
    if [ -f "$DOCKER_CFG" ]; then
        tmp=$(mktemp)
        jq --arg d "$PLUGINS_DIR" \
            '.cliPluginsExtraDirs = ((.cliPluginsExtraDirs // []) + [$d] | unique)' \
            "$DOCKER_CFG" > "$tmp" && mv "$tmp" "$DOCKER_CFG"
    else
        printf '{\n  "cliPluginsExtraDirs": ["%s"]\n}\n' "$PLUGINS_DIR" > "$DOCKER_CFG"
    fi
    if ! docker compose version >/dev/null 2>&1; then
        echo "docker compose plugin still unavailable (is docker-compose installed?); retrying next apply" >&2
        exit 0
    fi
fi

# The media must be present on the host (and thus in the VM via the Colima
# mount); otherwise Shoko would import an empty folder.
if [ ! -d "$MEDIA" ]; then
    echo "WARNING: '$MEDIA' not found on host -- is the Easystore drive mounted?" >&2
fi

mkdir -p "$COMPOSE_DIR"
NEW_COMPOSE=$(cat <<EOF
# Shoko Server -- anime metadata/organization backend for Jellyfin (Shokofin).
# Generated by chezmoi run_after_07-install-shoko. Mac mini only.
# Edit this script (not the generated file) to change the config.
services:
  shoko:
    image: ghcr.io/shokoanime/server:latest
    container_name: shoko
    restart: unless-stopped
    ports:
      - "127.0.0.1:8111:8111"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
    volumes:
      - shoko-config:/home/shoko/.shoko
      - "${MEDIA}:${MEDIA}:ro"
volumes:
  shoko-config:
EOF
)

# Fast path: compose file unchanged and Shoko already answering -> converged.
if [ -f "$COMPOSE_FILE" ] && [ "$NEW_COMPOSE" = "$(cat "$COMPOSE_FILE")" ] \
    && curl -fsS --max-time 2 http://127.0.0.1:8111/ >/dev/null 2>&1; then
    exit 0
fi

printf '%s\n' "$NEW_COMPOSE" > "$COMPOSE_FILE"

echo "Pulling Shoko image and starting the container..."
docker compose -f "$COMPOSE_FILE" up -d

echo "Waiting for Shoko on http://127.0.0.1:8111 ..."
if curl -fsS --retry 150 --retry-delay 2 --retry-connrefused --max-time 360 \
        http://127.0.0.1:8111/ >/dev/null 2>&1; then
    echo "Shoko Server is up. Finish setup at http://127.0.0.1:8111"
    echo "(create account, link AniDB, add import folder = $MEDIA)."
else
    echo "Shoko did not answer in time; check 'docker logs shoko'." >&2
fi
{{ end -}}
