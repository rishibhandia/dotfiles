{{ if and (eq .chezmoi.os "darwin") (eq .hostname "rishi-macmini-2020") -}}
#!/bin/bash
# Run the RustDesk OSS server (hbbs + hbbr) as Docker containers on the Mac mini.
# This is a self-hosted replacement for AnyDesk: owning the rendezvous server
# means no commercial-use nag, no session caps, and no third party brokering the
# connection.
#
#   hbbs = rendezvous/ID server -- registers client IDs, brokers hole punching
#   hbbr = relay server         -- carries the session only when P2P fails
#
# Port binding is deliberate and split by trust level:
#   21115/tcp, 21116/tcp+udp, 21117/tcp  ->  0.0.0.0 (LAN)
#       The native protocol ports. Bound wide so a router port-forward can
#       reach them. Clients authenticate with the server's ed25519 key, so
#       exposure alone does not make this an open relay.
#   21118/tcp, 21119/tcp                 ->  127.0.0.1 only
#       The WebSocket listeners. hbbs/hbbr TRUST the X-Real-IP and
#       X-Forwarded-For headers on these ports WITHOUT validating them, so
#       anything that can reach them directly can spoof an arbitrary client IP.
#       They must only ever be reached through a reverse proxy that sets those
#       headers itself. Never publish these directly.
#
# ALWAYS_USE_RELAY stays N so sessions prefer direct P2P and only fall back to
# hbbr, which keeps the mini's upstream bandwidth out of the hot path.
#
# Runs on EVERY apply (run_, not run_once) so a skipped precondition (docker
# missing, Colima down) retries next apply instead of being recorded done
# forever. When both containers are up and the compose file is unchanged it
# fast-path exits. No-op on every other machine.

set -e

eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true

: "${XDG_CONFIG_HOME:=$HOME/.config}"
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"

COMPOSE_DIR="$XDG_CONFIG_HOME/rustdesk"
COMPOSE_FILE="$COMPOSE_DIR/docker-compose.yml"

if ! command -v docker >/dev/null 2>&1; then
    echo "docker not installed yet; retrying on the next chezmoi apply" >&2
    exit 0
fi

# Colima (the Docker daemon) must be up; run_after_05 handles this.
if ! colima status >/dev/null 2>&1; then
    echo "Colima is not running (run_after_05 starts it); retrying RustDesk next apply" >&2
    exit 0
fi

# Homebrew's docker formula is the bare CLI; the Compose v2 plugin comes from
# the docker-compose formula and the CLI only finds it when
# ~/.docker/config.json lists the plugin dir (brew caveat). Wire it up once.
if ! docker compose version >/dev/null 2>&1; then
    BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
    PLUGINS_DIR="$BREW_PREFIX/lib/docker/cli-plugins"
    [ -d "$PLUGINS_DIR" ] || PLUGINS_DIR="$BREW_PREFIX/opt/docker-compose/bin"
    DOCKER_CFG="$HOME/.docker/config.json"
    mkdir -p "$HOME/.docker"
    if [ -f "$DOCKER_CFG" ]; then
        tmp=$(mktemp)
        jq --arg d "$PLUGINS_DIR" \
            '.cliPluginsExtraDirs = ((.cliPluginsExtraDirs // []) + [$d] | unique)' \
            "$DOCKER_CFG" > "$tmp" && mv "$tmp" "$DOCKER_CFG"
    else
        printf '{\n  "cliPluginsExtraDirs": ["%s"]\n}\n' "$PLUGINS_DIR" > "$DOCKER_CFG"
    fi
    if ! docker compose version >/dev/null 2>&1; then
        echo "docker compose plugin still unavailable (is docker-compose installed?); retrying next apply" >&2
        exit 0
    fi
fi

mkdir -p "$COMPOSE_DIR"
NEW_COMPOSE=$(cat <<'EOF'
# RustDesk OSS server -- self-hosted remote desktop rendezvous + relay.
# Generated by chezmoi run_after_10-install-rustdesk-server. Mac mini only.
# Edit that script (not this generated file) to change the config.
#
# WebSocket ports (21118/21119) are localhost-only on purpose: hbbs/hbbr trust
# unvalidated X-Forwarded-For headers on them. Front them with a reverse proxy,
# never publish them directly.
services:
  hbbs:
    image: rustdesk/rustdesk-server:latest
    container_name: hbbs
    command: hbbs
    restart: unless-stopped
    ports:
      - "21115:21115"
      - "21116:21116"
      - "21116:21116/udp"
      - "127.0.0.1:21118:21118"
    volumes:
      - rustdesk-data:/root
    depends_on:
      - hbbr
  hbbr:
    image: rustdesk/rustdesk-server:latest
    container_name: hbbr
    command: hbbr
    restart: unless-stopped
    ports:
      - "21117:21117"
      - "127.0.0.1:21119:21119"
    volumes:
      - rustdesk-data:/root
volumes:
  rustdesk-data:
EOF
)

running() {
    [ "$(docker inspect -f '{{ "{{" }}.State.Running{{ "}}" }}' "$1" 2>/dev/null)" = "true" ]
}

# Fast path: compose file unchanged and both containers up -> converged.
if [ -f "$COMPOSE_FILE" ] && [ "$NEW_COMPOSE" = "$(cat "$COMPOSE_FILE")" ] \
    && running hbbs && running hbbr; then
    exit 0
fi

printf '%s\n' "$NEW_COMPOSE" > "$COMPOSE_FILE"

echo "Pulling RustDesk server image and starting hbbs/hbbr..."
docker compose -f "$COMPOSE_FILE" up -d

# hbbs speaks the RustDesk protocol, not HTTP, so health == the listener is up.
echo "Waiting for hbbs on 127.0.0.1:21116 ..."
for _ in $(seq 1 30); do
    if nc -z 127.0.0.1 21116 2>/dev/null; then
        break
    fi
    sleep 2
done

if ! nc -z 127.0.0.1 21116 2>/dev/null; then
    echo "hbbs did not open 21116 in time; check 'docker logs hbbs'." >&2
    exit 0
fi

# The PUBLIC key is meant to be distributed -- every client must present it or
# the server refuses them. The private key never leaves the volume.
PUBKEY=$(docker run --rm -v rustdesk_rustdesk-data:/d alpine:latest \
    cat /d/id_ed25519.pub 2>/dev/null || true)

echo "RustDesk server is up (hbbs 21115/21116, hbbr 21117)."
if [ -n "$PUBKEY" ]; then
    echo "Client 'Key' field: $PUBKEY"
else
    echo "Could not read the public key; fetch it manually: docker exec hbbs cat /root/id_ed25519.pub" >&2
fi
{{ end -}}
