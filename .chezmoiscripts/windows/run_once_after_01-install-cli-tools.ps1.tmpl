{{- if eq .chezmoi.os "windows" -}}
#Requires -Version 5.1
# Install CLI tools that aren't available via Scoop/portable binaries
# Runs once after dotfiles are applied

$ErrorActionPreference = "Continue"

# Colors
function Write-Info { param($Message) Write-Host "[INFO] $Message" -ForegroundColor Blue }
function Write-Success { param($Message) Write-Host "[OK] $Message" -ForegroundColor Green }
function Write-Warn { param($Message) Write-Host "[WARN] $Message" -ForegroundColor Yellow }

# -----------------------------------------------------------------------------
# Claude Code (Anthropic's AI coding assistant)
# https://code.claude.com/docs/en/setup
# Try: winget -> native installer -> npm (in order of preference)
# -----------------------------------------------------------------------------
if (Get-Command claude -ErrorAction SilentlyContinue) {
    Write-Success "Claude Code already installed"
} else {
    $installed = $false

    # Method 1: winget (if available)
    if (-not $installed -and (Get-Command winget -ErrorAction SilentlyContinue)) {
        Write-Info "Installing Claude Code via winget..."
        try {
            winget install Anthropic.ClaudeCode --accept-source-agreements --accept-package-agreements
            if ($LASTEXITCODE -eq 0) {
                Write-Success "Claude Code installed via winget"
                Write-Info "Note: Run 'winget upgrade Anthropic.ClaudeCode' periodically to update"
                $installed = $true
            }
        } catch {
            Write-Warn "winget installation failed, trying alternative..."
        }
    }

    # Method 2: Native installer (recommended by Anthropic)
    if (-not $installed) {
        Write-Info "Installing Claude Code via native installer..."
        try {
            Invoke-RestMethod https://claude.ai/install.ps1 | Invoke-Expression
            if (Get-Command claude -ErrorAction SilentlyContinue) {
                Write-Success "Claude Code installed via native installer"
                $installed = $true
            }
        } catch {
            Write-Warn "Native installer failed: $_"
        }
    }

    # Method 3: npm (requires Node.js 18+)
    if (-not $installed -and (Get-Command npm -ErrorAction SilentlyContinue)) {
        Write-Info "Installing Claude Code via npm..."
        try {
            npm install -g @anthropic-ai/claude-code
            if ($LASTEXITCODE -eq 0) {
                Write-Success "Claude Code installed via npm"
                $installed = $true
            }
        } catch {
            Write-Warn "npm installation failed: $_"
        }
    }

    if (-not $installed) {
        Write-Warn "Claude Code installation failed. Install manually:"
        Write-Warn "  winget install Anthropic.ClaudeCode"
        Write-Warn "  OR: irm https://claude.ai/install.ps1 | iex"
    }
}

# -----------------------------------------------------------------------------
# Tirith (Terminal security - guards against URL/ANSI injection attacks)
# https://github.com/sheeki03/tirith
# Requires Scoop
# -----------------------------------------------------------------------------
if (Get-Command tirith -ErrorAction SilentlyContinue) {
    Write-Success "Tirith already installed"
} elseif (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Info "Installing Tirith via Scoop..."
    try {
        # Add tirith bucket if not present
        $buckets = scoop bucket list 2>$null
        if ($buckets -notcontains "tirith") {
            scoop bucket add tirith https://github.com/sheeki03/scoop-tirith 2>&1 | Out-Null
        }
        scoop install tirith 2>&1 | Out-Null
        if ($LASTEXITCODE -eq 0) {
            Write-Success "Tirith installed via Scoop"
        } else {
            Write-Warn "Tirith installation failed"
        }
    } catch {
        Write-Warn "Tirith installation failed: $_"
    }
} else {
    Write-Warn "Scoop not available. Install Tirith manually:"
    Write-Warn "  scoop bucket add tirith https://github.com/sheeki03/scoop-tirith && scoop install tirith"
}


# -----------------------------------------------------------------------------
# Neovim plugins (vim-plug + PlugInstall)
# -----------------------------------------------------------------------------
if (Get-Command nvim -ErrorAction SilentlyContinue) {
    $plugPath = "$env:LOCALAPPDATA\nvim\autoload\plug.vim"
    if (-not (Test-Path $plugPath)) {
        Write-Info "Installing vim-plug..."
        New-Item -ItemType Directory -Force -Path (Split-Path $plugPath) | Out-Null
        try {
            Invoke-WebRequest -Uri "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim" `
                -OutFile $plugPath -UseBasicParsing
            Write-Success "vim-plug installed"
        } catch {
            Write-Warn "vim-plug installation failed: $_"
        }
    }
    Write-Info "Installing Neovim plugins..."
    try {
        nvim --headless +PlugInstall +qall 2>$null
        Write-Success "Neovim plugins installed"
    } catch {
        Write-Warn "Neovim plugin installation failed (non-fatal)"
    }
} else {
    Write-Warn "nvim not found, skipping plugin installation"
}

# -----------------------------------------------------------------------------
# psmux (Terminal multiplexer - tmux alternative for Windows Terminal)
# https://github.com/marlocarlo/psmux
# Portable: direct binary from GitHub releases (SHA256 logged for audit)
# Non-portable: via Scoop manifest URL
# -----------------------------------------------------------------------------
if (Get-Command psmux -ErrorAction SilentlyContinue) {
    Write-Success "psmux already installed"
} else {
{{- if .portable }}
    Write-Info "Installing psmux (portable binary from GitHub)..."
    try {
        $arch = if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { 'arm64' }
                elseif ([System.Environment]::Is64BitOperatingSystem) { 'x64' }
                else { 'x86' }

        $release = Invoke-RestMethod "https://api.github.com/repos/marlocarlo/psmux/releases/latest" -UseBasicParsing
        $version = $release.tag_name
        $zipName = "psmux-$version-windows-$arch.zip"
        $downloadUrl = "https://github.com/marlocarlo/psmux/releases/download/$version/$zipName"

        $tmpZip = Join-Path $env:TEMP $zipName
        Write-Info "Downloading $downloadUrl..."
        Invoke-WebRequest -Uri $downloadUrl -OutFile $tmpZip -UseBasicParsing

        $hash = (Get-FileHash $tmpZip -Algorithm SHA256).Hash
        Write-Info "psmux $version SHA256: $hash"

        $installDir = "$env:USERPROFILE\.local\bin\psmux"
        New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        Expand-Archive -Path $tmpZip -DestinationPath $installDir -Force
        Remove-Item $tmpZip -Force

        $userPath = [Environment]::GetEnvironmentVariable("PATH", "User")
        if ($userPath -notlike "*$installDir*") {
            [Environment]::SetEnvironmentVariable("PATH", "$userPath;$installDir", "User")
            $env:PATH = "$env:PATH;$installDir"
        }

        Write-Success "psmux $version installed to $installDir"
    } catch {
        Write-Warn "psmux installation failed: $_"
    }
{{- else }}
    if (Get-Command scoop -ErrorAction SilentlyContinue) {
        Write-Info "Installing psmux via Scoop..."
        try {
            scoop install https://raw.githubusercontent.com/marlocarlo/psmux/master/scoop/psmux.json 2>&1 | Out-Null
            if ($LASTEXITCODE -eq 0) {
                Write-Success "psmux installed via Scoop"
            } else {
                Write-Warn "psmux Scoop installation failed"
            }
        } catch {
            Write-Warn "psmux installation failed: $_"
        }
    } else {
        Write-Warn "Scoop not available. Install psmux manually:"
        Write-Warn "  scoop install https://raw.githubusercontent.com/marlocarlo/psmux/master/scoop/psmux.json"
    }
{{- end }}
}

{{ end -}}
