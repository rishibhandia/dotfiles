{{ if and (eq .chezmoi.os "darwin") (eq .hostname "rishi-macmini-2020") -}}
#!/bin/bash
# Expose Jellyfin over Tailscale Serve on https://<mini>.<tailnet>.ts.net:8443.
# Uses a dedicated HTTPS port (not a path mount) so Jellyfin's BaseUrl can
# stay at the default empty value; path mounts trigger double-prefixing on
# Jellyfin redirects which breaks native mobile apps.
# Idempotent: tailscale serve overwrites the existing config for the same port.
# No-op on every other machine.

set -e

eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true

# The tailscale-app cask does NOT symlink the CLI onto PATH; the app bundle
# binary doubles as the CLI, so fall back to it.
TAILSCALE="$(command -v tailscale || true)"
if [ -z "$TAILSCALE" ] && [ -x "/Applications/Tailscale.app/Contents/MacOS/Tailscale" ]; then
    TAILSCALE="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
fi
if [ -z "$TAILSCALE" ]; then
    echo "tailscale CLI not found (checked PATH and /Applications/Tailscale.app); skipping" >&2
    exit 0
fi

# Skip if not logged into a tailnet (fresh machine before manual login).
# NOTE: run_once records this script as done even on these graceful skips;
# after logging in, re-run with:
#   chezmoi state delete-bucket --bucket=scriptState && chezmoi apply
if ! "$TAILSCALE" status >/dev/null 2>&1; then
    echo "tailscale not logged in; skipping Jellyfin serve setup" >&2
    exit 0
fi

"$TAILSCALE" serve --bg --https=8443 http://localhost:8096 >/dev/null
{{ end -}}
