{{ if eq .chezmoi.os "darwin" "linux" -}}
#!/bin/bash
# Install CLI tools that aren't available via Homebrew
# Runs once after dotfiles are applied

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
NC='\033[0m'

info() { printf "${BLUE}[INFO]${NC} %s\n" "$1"; }
success() { printf "${GREEN}[OK]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[WARN]${NC} %s\n" "$1"; }

# -----------------------------------------------------------------------------
# Claude Code (Anthropic's AI coding assistant)
# https://claude.ai/code
# A migrated binary keeps its original CPU arch: after a cross-arch restore
# (Intel -> Apple Silicon via Migration Assistant) the x86_64 build runs under
# Rosetta, which lacks AVX, so Claude's Bun runtime warns and may crash. Detect
# an arch mismatch and force a clean native reinstall.
# -----------------------------------------------------------------------------
# True hardware arch — sysctl is reliable even when the shell is under Rosetta.
if [ "$(uname -s)" = "Darwin" ] && [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
    HW_ARCH="arm64"
else
    HW_ARCH="$(uname -m)"
fi

install_claude() {
    info "Installing Claude Code (native ${HW_ARCH})..."
    # Trust: Anthropic (https://claude.ai/install.sh). Vendor-controlled URL,
    # no integrity check — accepted because the alternative is manual install
    # of a moving-target binary on every fresh-machine bootstrap.
    if [ "$(uname -s)" = "Darwin" ]; then
        # arch -<hw> forces the native slice even if this shell is translated.
        if arch -"${HW_ARCH}" bash -c "$(curl -fsSL https://claude.ai/install.sh)"; then
            success "Claude Code installed (${HW_ARCH})"
        else
            warn "Claude Code installation failed"
        fi
    else
        if curl -fsSL https://claude.ai/install.sh | sh; then
            success "Claude Code installed"
        else
            warn "Claude Code installation failed"
        fi
    fi
}

if command -v claude &>/dev/null; then
    # In this non-interactive bash script the caffeinate alias isn't present,
    # so command -v resolves the real binary path.
    CLAUDE_BIN="$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")"
    BIN_ARCH="$(file -L "$CLAUDE_BIN" 2>/dev/null | grep -oE 'arm64|x86_64' | head -1)"
    if [ -n "$BIN_ARCH" ] && [ "$BIN_ARCH" != "$HW_ARCH" ]; then
        warn "Claude Code is ${BIN_ARCH} but this Mac is ${HW_ARCH}; forcing native reinstall"
        rm -rf "$HOME/.local/share/claude/versions" "$HOME/.local/bin/claude" 2>/dev/null || true
        install_claude
    else
        success "Claude Code already installed (${BIN_ARCH:-arch ok})"
    fi
else
    install_claude
fi

# -----------------------------------------------------------------------------
# Shell Sage (AI-powered shell assistant)
# https://github.com/AnswerDotAI/shell_sage
# -----------------------------------------------------------------------------
if command -v ssage &>/dev/null; then
    success "Shell Sage already installed"
else
    if command -v uv &>/dev/null; then
        info "Installing Shell Sage via uv..."
        if uv tool install shell-sage; then
            success "Shell Sage installed"
        else
            warn "Shell Sage installation failed"
        fi
    else
        warn "uv not found, skipping Shell Sage installation"
    fi
fi


# -----------------------------------------------------------------------------
# rtk - wire the Bash output-compression hook into Claude Code's global config
# https://github.com/rtk-ai/rtk
# --auto-patch: non-interactive (no Y/N prompt)
# --hook-only: install the Bash hook only; skip RTK.md and the @RTK.md
#              reference in CLAUDE.md (the hook works transparently — Claude
#              doesn't need to know rtk exists).
# Idempotent: rtk init re-applies the same hook entry on subsequent runs.
# -----------------------------------------------------------------------------
if command -v rtk &>/dev/null; then
    info "Wiring rtk hook into Claude Code (global)..."
    if rtk init -g --auto-patch --hook-only >/dev/null 2>&1; then
        success "rtk hook installed"
    else
        warn "rtk init failed (non-fatal — run 'rtk init -g --auto-patch --hook-only' manually)"
    fi
else
    warn "rtk not found, skipping hook setup"
fi

{{ if .personal -}}
# -----------------------------------------------------------------------------
# Tirith MCP server for Claude Code (personal machines)
# A "mcpServers" key in settings.json is NOT honored by Claude Code;
# user-scope servers must be registered via `claude mcp add`, which
# writes ~/.claude.json.
# -----------------------------------------------------------------------------
if command -v claude &>/dev/null && command -v tirith &>/dev/null; then
    # Register idempotently. We deliberately avoid `claude mcp list` here: its
    # per-server health check can hang (e.g. a misbuilt/Rosetta claude), which
    # previously stalled the entire apply. `claude mcp add` only writes config;
    # a duplicate add returns non-zero, which we treat as "already registered".
    info "Registering tirith MCP server with Claude Code (user scope)..."
    if claude mcp add --scope user tirith -- tirith mcp-server >/dev/null 2>&1; then
        success "tirith MCP server registered"
    else
        info "tirith MCP server already registered (or add skipped)"
    fi
else
    warn "claude or tirith not found, skipping tirith MCP registration"
fi
{{ end -}}

# -----------------------------------------------------------------------------
# Tirith PreToolUse hook for Claude Code (any machine with tirith)
# Writes ~/.claude/hooks/tirith-check.py and merges a PreToolUse Bash hook
# into ~/.claude/settings.json so every command Claude runs is vetted by
# tirith (fail-closed). Idempotent: skips files that are already up to date.
# Side effect: appends `eval "$(tirith init)"` to ~/.zshrc, which is inert
# here — ZDOTDIR points zsh at ~/.config/zsh/.zshrc, which already runs it.
# -----------------------------------------------------------------------------
if command -v claude &>/dev/null && command -v tirith &>/dev/null; then
    info "Configuring tirith PreToolUse hook for Claude Code..."
    if tirith setup claude-code --scope user --quiet >/dev/null 2>&1; then
        success "tirith Claude Code hook configured"
    else
        warn "tirith setup failed (run manually: tirith setup claude-code --scope user)"
    fi
else
    warn "claude or tirith not found, skipping tirith Claude Code hook"
fi

# -----------------------------------------------------------------------------
# Neovim plugins (vim-plug + PlugInstall)
# -----------------------------------------------------------------------------
if command -v nvim &>/dev/null; then
    PLUG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/autoload/plug.vim"
    if [ ! -f "$PLUG_PATH" ]; then
        info "Installing vim-plug..."
        mkdir -p "$(dirname "$PLUG_PATH")"
        if curl -fLo "$PLUG_PATH" --create-dirs \
            https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim; then
            success "vim-plug installed"
        else
            warn "vim-plug installation failed"
        fi
    fi
    info "Installing Neovim plugins..."
    if nvim --headless +PlugInstall +qall 2>/dev/null; then
        success "Neovim plugins installed"
    else
        warn "Neovim plugin installation failed (non-fatal)"
    fi
else
    warn "nvim not found, skipping plugin installation"
fi

{{ end -}}
