{{ if and (eq .chezmoi.os "darwin") (eq .hostname "rishi-macmini-2020") -}}
#!/bin/bash
# Run Colima from its XDG location (~/.config/colima) with the resources and
# drive mount needed to host Shoko Server (Docker) for the Jellyfin anime
# library. Replaces the old `brew services start colima` approach so we can:
#   - pin COLIMA_HOME (Colima 0.10.x has flaky XDG auto-detection), and
#   - mount the external media drive (/Volumes/Easystore) into the VM.
# Auto-start at login is handled by the chezmoi-managed LaunchAgent
# ~/Library/LaunchAgents/com.rishi.colima.plist.
#
# Runs on EVERY apply (run_, not run_once) so a skipped precondition (colima
# not installed yet, drive unmounted) retries next apply instead of being
# recorded done forever. Creates the VM only if it doesn't already exist, and
# NEVER deletes an existing VM (that would wipe Docker named volumes such as
# Shoko's database). Recreating the VM is a deliberate manual step.
# No-op on every other machine.

set -e

eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"

PLIST="$HOME/Library/LaunchAgents/com.rishi.colima.plist"
MEDIA_MOUNT="/Volumes/Easystore"

if ! command -v colima >/dev/null 2>&1; then
    echo "colima not installed yet; retrying on the next chezmoi apply" >&2
    exit 0
fi

# Distinguish "VM exists" (colima list) from "VM running" (colima status):
# `colima status` fails for a stopped-but-existing VM, which previously sent
# us down the creation path with create-only flags.
vm_exists=0
colima list 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "default" && vm_exists=1

if [ "$vm_exists" -eq 0 ]; then
    # Creating the VM needs the media drive present, or the --mount fails
    # (and a missing drive should not abort the whole apply).
    if [ ! -d "$MEDIA_MOUNT" ]; then
        echo "WARNING: $MEDIA_MOUNT not mounted; skipping Colima VM creation (retries next apply)" >&2
        exit 0
    fi
    # Retire the old brew-services registration if present (harmless otherwise).
    brew services stop colima >/dev/null 2>&1 || true
    echo "Creating Colima VM at $COLIMA_HOME (4 CPU / 6 GiB; $MEDIA_MOUNT mounted read-only)..."
    colima start \
        --cpu 4 --memory 6 --disk 100 \
        --vm-type vz --mount-type virtiofs \
        --mount "$MEDIA_MOUNT"
elif ! colima status >/dev/null 2>&1; then
    echo "Starting existing Colima VM..."
    colima start >/dev/null 2>&1 || true
fi
# (VM exists and is running: nothing to do)

# Load the auto-start LaunchAgent if it isn't loaded (chezmoi wrote the plist).
# After editing the plist, bounce it manually: launchctl unload && launchctl load.
mkdir -p "$XDG_STATE_HOME/colima"
if [ -f "$PLIST" ] && ! launchctl list 2>/dev/null | grep -q "com.rishi.colima"; then
    launchctl load "$PLIST" >/dev/null 2>&1 || true
fi
{{ end -}}
