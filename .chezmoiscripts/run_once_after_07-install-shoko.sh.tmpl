{{ if and (eq .chezmoi.os "darwin") (eq .hostname "rishi-macmini-2020") -}}
#!/bin/bash
# Install/refresh Shoko Server as a Docker container on the Mac mini. Shoko is
# the anime metadata + organization backend that Jellyfin's Shokofin plugin
# talks to. Apple Silicon native Shoko is unsupported upstream, so we run the
# official image on Colima (the VM is created by run_once_after_05).
#
# The anime drive is bind-mounted at the SAME path it has on the host
# (/Volumes/Easystore/Movies & Shows) so the symlinks Shokofin builds on the
# host resolve with no path remapping. Shoko's own data lives in a Docker named
# volume so it survives container recreation (mounting the config dir wrong is a
# known data-loss footgun).
#
# Idempotent: `docker compose up -d` only recreates the container when the
# compose file changes. No-op on every other machine.

set -e

eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true

: "${XDG_CONFIG_HOME:=$HOME/.config}"
export COLIMA_HOME="$XDG_CONFIG_HOME/colima"

COMPOSE_DIR="$XDG_CONFIG_HOME/shoko"
COMPOSE_FILE="$COMPOSE_DIR/docker-compose.yml"
MEDIA="/Volumes/Easystore/Movies & Shows"

if ! command -v docker >/dev/null 2>&1; then
    echo "docker not installed yet; brew bundle should install it before this runs" >&2
    exit 0
fi

# Colima (the Docker daemon) must be up; run_once_after_05 handles this.
if ! colima status >/dev/null 2>&1; then
    echo "Colima is not running; start it first (run_once_after_05). Skipping Shoko." >&2
    exit 0
fi

# The media must be present on the host (and thus in the VM via the Colima
# mount); otherwise Shoko would import an empty folder.
if [ ! -d "$MEDIA" ]; then
    echo "WARNING: '$MEDIA' not found on host -- is the Easystore drive mounted?" >&2
fi

mkdir -p "$COMPOSE_DIR"
cat > "$COMPOSE_FILE" <<EOF
# Shoko Server -- anime metadata/organization backend for Jellyfin (Shokofin).
# Generated by chezmoi run_once_after_07-install-shoko. Mac mini only.
# Edit this script (not the generated file) to change the config.
services:
  shoko:
    image: ghcr.io/shokoanime/server:latest
    container_name: shoko
    restart: unless-stopped
    ports:
      - "127.0.0.1:8111:8111"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
    volumes:
      - shoko-config:/home/shoko/.shoko
      - "${MEDIA}:${MEDIA}:ro"
volumes:
  shoko-config:
EOF

echo "Pulling Shoko image and starting the container..."
docker compose -f "$COMPOSE_FILE" up -d

echo "Waiting for Shoko on http://127.0.0.1:8111 ..."
if curl -fsS --retry 150 --retry-delay 2 --retry-connrefused --max-time 360 \
        http://127.0.0.1:8111/ >/dev/null 2>&1; then
    echo "Shoko Server is up. Finish setup at http://127.0.0.1:8111"
    echo "(create account, link AniDB, add import folder = $MEDIA)."
else
    echo "Shoko did not answer in time; check 'docker logs shoko'." >&2
fi
{{ end -}}
