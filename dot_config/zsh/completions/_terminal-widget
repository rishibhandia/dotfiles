#compdef terminal-widget
# generated by terminal-widget completions

if (( CURRENT > 2 )) && [[ ${words[2]} == completions ]]; then
  shift words
  (( CURRENT-- ))
  _arguments -s -S \
    '--shell[Target shell]:shell:(fish bash zsh all)' \
    '--name[Command name used in generated scripts]:name:' \
    '--install[Install into the user completion directory]' \
    '--stdout[Print one script to stdout]' \
    '(--help -h)'{--help,-h}'[Show help]'
  return
fi

local context state line
_arguments -s -S \
  '(--help -h)'{--help,-h}'[Show help]' \
  '(--verbose -v)'{--verbose,-v}'[Print diagnostics]' \
  '--version[Print version]' \
  '--target[Widget target name]:target:' \
  '--text[Text line or - for stdin]:text:(-)' \
  '--no-wrap[Truncate instead of wrap]' \
  '--ansi-mode[ANSI rendering mode]:ansi-mode:(auto on off)' \
  '--strip-colors[Strip ANSI colors]' \
  '--icon[SF Symbol name]:icon:' \
  '--image[Image path or URL]:image:_files' \
  '--filter[Image filter]:filter:(grayscale gray mono sepia negative invert inverted pixelate pixellate blur alpha)' \
  '--full-width[Alias for --padding fill]' \
  '--fit-text[Fit text to widget]' \
  '--font[Font name]:font:' \
  '--font-size[Font size points]:font-size:' \
  '(--foreground --fg)'{--foreground,--fg}'[Foreground color]:foreground:' \
  '--text-color[Text color]:text-color:' \
  '--caption-color[Caption color]:caption-color:' \
  '--title-color[Title color]:title-color:' \
  '(--background --bg)'{--background,--bg}'[Background color or bare mode]:background:' \
  '--background-mode[No LaunchServices handoff]' \
  '--alpha[Color alpha 0..1]:alpha:' \
  '--progress[Progress 0-100]:progress:' \
  '--progress-format[Progress style]:progress-format:(bar matrix dots stack circle watch gradient gradient-horizontal gradient-vertical)' \
  '--gradient-from[Progress gradient start]:gradient-from:' \
  '--gradient-to[Progress gradient end]:gradient-to:' \
  '--gradient-width[Gradient thickness]:gradient-width:' \
  '--bg-gradient-from[Background gradient start]:bg-gradient-from:' \
  '(--bg-gradient-to --bg-gradent-to)'{--bg-gradient-to,--bg-gradent-to}'[Background gradient end]:bg-gradient-to:' \
  '--bg-gradient-start[Background gradient direction]:bg-gradient-start:(n s e w nw ne sw se top right bottom left topleft topright bottomleft bottomright)' \
  '--chart[Chart values or - for stdin]:chart:(-)' \
  '--append[Append chart columns or text lines]:append:(-)' \
  '--limit[Keep last N chart columns or text lines]:limit:' \
  '--chart-format[Chart style]:chart-format:(sparkline spark bar graph line waveform wave area lollipop strip dot radial delta threshold smooth sine peak neo matrix rangebar)' \
  '--chart-height[Chart height points or %]:chart-height:' \
  '--neo-characters[Neo character set]:neo-characters:(katakana ascii binary)' \
  '--base-zero[Chart baseline 0]' \
  '--base[Chart baseline N]:base:' \
  '--bar-radius[Bar corner radius 0-100]:bar-radius:' \
  '--chart-bar-style[Bar fill style]:chart-bar-style:(solid glass)' \
  '(--sparkline --spark)'{--sparkline,--spark}'[Legacy sparkline values]:sparkline:(-)' \
  '--graph[Legacy graph values]:graph:(-)' \
  '--waveform[Legacy waveform values]:waveform:(-)' \
  '--matrix[Legacy matrix values]:matrix:(-)' \
  '--table[Table file or - for stdin]: :->table' \
  '--no-header[Table without header styling]' \
  '--grid[Table grid mode]:grid:(none row horizontal column vertical both zebra zebra-row zebra-column)' \
  '--no-grid[Alias for --grid none]' \
  '--table-layout[Table column layout]:table-layout:(auto equal)' \
  '--zebra-opacity[Zebra opacity]:zebra-opacity:' \
  '--caption[Show auto caption]' \
  '--caption-text[Custom caption text]:caption-text:' \
  '--caption-left[Left footer caption]:caption-left:' \
  '--caption-right[Right footer caption]:caption-right:' \
  '--annotate[Annotate chart values]' \
  '--label-y[Show Y axis labels]' \
  '--timestamp[Show last-update time]' \
  '--title[Widget title]:title:' \
  '--title-alignment[Title alignment]:title-alignment:(left center right)' \
  '--padding[Padding points or fill]:padding:(fill)' \
  '--fullsize[Shortcut for --padding 0]' \
  '--command[Shell command for text]:command:' \
  '(--theme --mode)'{--theme,--mode}'[Color theme]:theme:(system light dark)' \
  '--notify[Persist notify-on-change]' \
  '--no-notify[Disable notify-on-change]' \
  '--notify-once[Notify once if changed]' \
  '--json[JSON source file, URL, or -]: :->json' \
  '(--action-kind --tap-action)'{--action-kind,--tap-action}'[Tap action kind]:action-kind:(open-url open-app run-shortcut run-command refresh)' \
  '(--action-value --tap-action-value)'{--action-value,--tap-action-value}'[Tap action value]:action-value:' \
  '--clear-action[Clear tap action]' \
  '--clear[Delete target payload and local data]' \
  '--clear-buttons[Remove launcher buttons only]' \
  '--strict-local-open[Fail on open handoff errors]' \
  '1: :(completions)' \
&& return 0

case $state in
  table)
    _alternative \
      'files:file:_files' \
      'dash:stdin:(-)'
    ;;
  json)
    _alternative \
      'files:file:_files' \
      'dash:stdin:(-)'
    ;;
esac
