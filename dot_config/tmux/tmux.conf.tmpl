# =============================================================================
# Terminal settings (Ghostty/modern terminal compatibility)
# =============================================================================
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"
set -ag terminal-overrides ",xterm-ghostty:RGB"
set-option -g allow-passthrough on
set -s extended-keys on
set -as terminal-features 'xterm*:extkeys'
# Pass OSC 8 hyperlinks through to the terminal so links stay clickable (tmux 3.4+)
set -as terminal-features '*:hyperlinks'

{{ template "tmux-shared" . }}

# =============================================================================
# Plugins (tmux-only — psmux shares the snippet above, not this block).
# TPM itself is cloned by chezmoi via .chezmoiexternal.toml.
# =============================================================================
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
# Restore pane working directories and layouts across reboots.
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
# Initialize TPM (must stay the last line of this file).
run '~/.config/tmux/plugins/tpm/tpm'
